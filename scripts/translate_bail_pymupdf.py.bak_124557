# Text color (dark blue matching original template)
TEXT_COLOR = fitz.pdfcolor["black"]  # Using black for better compatibility


import re
def normalize_text(text):
    """Normalize text for matching: strip, collapse whitespace, fix encoding issues."""
    normalized = re.sub(r'\s+', ' ', text.strip())
    # Fix common PDF font encoding errors where superscript chars replace accented chars
    # In this PDF, ² (U+00B2) is used where É (U+00C9) should be
    normalized = normalized.replace('\u00b2', 'É')
    # Fix ° (U+00B0) used where à (U+00E0) should be
    normalized = normalized.replace('\u00b0', 'à')
    return normalized


def normalize_for_match(text):
    """Full normalization for dictionary matching."""
    normalized = normalize_text(text)
    # Strip leading bullet chars: •, –, -, *, □
    normalized = re.sub(r'^[\u2022\u2013\u2014\-\*\u25a1\u00b7\u2023\u25aa\u25ab\u2043\u2219\uf0b7]+\s*', '', normalized)
    # Strip trailing punctuation that may/may not be in dictionary
    normalized = re.sub(r'[,.:;]+$', '', normalized).strip()
    # Remove underscores AND any text that follows them (form field content)
    # e.g. "Montant : _____ MAD" → "Montant :"
    no_underscores = re.sub(r'_+\s*\S*$', '', normalized).strip()
    # Also remove standalone underscore sequences mid-text
    no_underscores = re.sub(r'_+', '', no_underscores)
    return re.sub(r'\s+', ' ', no_underscores).strip()


def fix_encoding(text):
    """Fix PDF font encoding issues by replacing common wrong chars with correct ones."""
    # The Calibri font in this PDF sometimes maps:
    # é (U+00E9) → è (U+00E8) in certain contexts
    # We can't blindly replace è→é because è is used correctly elsewhere
    # Instead, build a list of known correct words/phrases and try matching with variants
    return text


def build_variants(text):
    """Build common encoding variants of text for matching."""
    variants = set()
    variants.add(text)
    
    # Replace é↔è (common Calibri encoding swap)
    v1 = text.replace('\u00e9', '\u00e8').replace('\u00e8', '\u00e9')
    variants.add(v1)
    
    # Replace â↔à 
    v2 = text.replace('\u00e2', '\u00e0').replace('\u00e0', '\u00e2')
    variants.add(v2)
    
    # Replace all accented chars with their base forms as last resort
    # (not ideal but helps with matching)
    
    return variants

def build_normalized_dict(translations_dict):
    """Pre-build a normalized lookup dict for fast matching."""
    norm_dict = {}
    for key, value in translations_dict.items():
        # Store with various normalizations
        stripped = key.strip()
        normalized = normalize_text(stripped)
        nf = normalize_for_match(stripped)
        no_trail = re.sub(r'[\s,.:;]+$', '', stripped).strip()
        nf_trail = re.sub(r'[\s,.:;]+$', '', nf).strip()

        for k in [stripped, normalized, nf, no_trail, nf_trail]:
            if k and k not in norm_dict:
                norm_dict[k] = value
    return norm_dict


def match_dict(text, translations_dict, norm_dict=None):
    """Try to match text against dictionary. Returns (translation, matched_key) or (None, None)."""
    if norm_dict is None:
        norm_dict = build_normalized_dict(translations_dict)

    # Try all encoding variants
    for variant in build_variants(text):
        # Exact match
        if variant in translations_dict:
            return translations_dict[variant], variant

        # Stripped match
        stripped = variant.strip()
        if stripped in translations_dict:
            return translations_dict[stripped], stripped

        # Normalized whitespace match
        normalized = normalize_text(variant)
        if normalized in translations_dict:
            return translations_dict[normalized], normalized

        # Underscore-stripped match
        nf = normalize_for_match(variant)
        if nf in translations_dict:
            return translations_dict[nf], nf

        # Strip trailing punctuation (also with preceding space: " ;", " :", " .")
        no_trail = re.sub(r'[\s,.:;]+$', '', stripped).strip()
        if no_trail in translations_dict:
            return translations_dict[no_trail], no_trail
        no_trail_norm = normalize_text(no_trail)
        if no_trail_norm in translations_dict:
            return translations_dict[no_trail_norm], no_trail_norm

        # Strip trailing punctuation from normalized form
        nf_trail = re.sub(r'[\s,.:;]+$', '', nf).strip()
        if nf_trail in translations_dict:
            return translations_dict[nf_trail], nf_trail

        # Try pre-normalized dictionary
        for k in [stripped, normalized, nf, no_trail, nf_trail]:
            if k in norm_dict:
                return norm_dict[k], k

    # Try with different unicode dashes (em dash vs hyphen vs en dash)
    for dash_char in ['—', '–', '-', '\u2014', '\u2013']:
        variant = text.replace(dash_char, '—')
        if variant in translations_dict:
            return translations_dict[variant], variant
        variant_nt = re.sub(r'[\s,.:;]+$', '', variant).strip()
        if variant_nt in translations_dict:
            return translations_dict[variant_nt], variant_nt
        if variant in norm_dict:
            return norm_dict[variant], variant
        if variant_nt in norm_dict:
            return norm_dict[variant_nt], variant_nt

    # PREFIX MATCHING: if text is a prefix of a dict key (truncated PDF text)
    # Find the longest dictionary key that starts with the normalized text
    normalized = normalize_text(text).strip()
    nf = normalize_for_match(text).strip()
    best_prefix_match = None
    best_prefix_key = None
    best_prefix_len = 0
    for dk, dv in translations_dict.items():
        dk_norm = normalize_text(dk).strip()
        # Check if the text is a prefix of the dict key
        if len(normalized) >= 15 and dk_norm.startswith(normalized):
            if len(normalized) > best_prefix_len:
                best_prefix_match = dv
                best_prefix_key = dk
                best_prefix_len = len(normalized)
        # Also check with nf (stripped bullets etc)
        if len(nf) >= 15 and dk_norm.startswith(nf):
            if len(nf) > best_prefix_len:
                best_prefix_match = dv
                best_prefix_key = dk
                best_prefix_len = len(nf)
        # Check if the dict key is a prefix of the text (text is longer)
        if len(dk_norm) >= 20 and normalized.startswith(dk_norm):
            if len(dk_norm) > best_prefix_len:
                best_prefix_match = dv
                best_prefix_key = dk
                best_prefix_len = len(dk_norm)

    if best_prefix_match is not None:
        return best_prefix_match, best_prefix_key

    return None, None


def extract_text_lines(page):
    """Extract text lines with positions from a page, grouping spans into lines."""
    blocks = page.get_text("dict", flags=fitz.TEXT_PRESERVE_WHITESPACE)["blocks"]
    lines = []
    for block in blocks:
        if block["type"] == 0:  # Text block
            for line in block["lines"]:
                line_text = ""
                line_bbox = None
                line_origin = None
                line_size = 0
                line_font = ""

                for span in line["spans"]:
                    line_text += span["text"]
                    if line_bbox is None:
                        line_bbox = span["bbox"]
                        line_origin = span["origin"]
                    else:
                        line_bbox = (
                            min(line_bbox[0], span["bbox"][0]),
                            min(line_bbox[1], span["bbox"][1]),
                            max(line_bbox[2], span["bbox"][2]),
                            max(line_bbox[3], span["bbox"][3]),
                        )
                    line_size = max(line_size, span["size"])
                    if not line_font:
                        line_font = span["font"]

                if line_text.strip():
                    lines.append({
                        "text": line_text,
                        "bbox": line_bbox,
                        "font": line_font,
                        "size": line_size,
                        "origin": line_origin,
                    })
    return lines


def reassemble_paragraphs(lines, translations_dict):
    """
    Reassemble split lines into paragraphs and match against dictionary.

    Strategy:
    1. Try matching each line individually (exact / normalized).
    2. If no match, greedily combine consecutive lines (up to MAX_JOIN)
       and try matching the combined text.
    3. When a match is found, consume all joined lines and record the
       combined bounding box + first line origin.
    4. If nothing matches after MAX_JOIN attempts, keep the line as-is.

    Returns a list of dicts:
        { "text": original, "translation": translated_or_None,
          "bbox": combined_bbox, "origin": first_origin,
          "size": font_size, "line_count": N }
    """
    MAX_JOIN = 12  # max lines to merge into one paragraph
    result = []
    i = 0
    norm_dict = build_normalized_dict(translations_dict)

    while i < len(lines):
        line = lines[i]

        # --- single-line match ---
        translation, _ = match_dict(line["text"], translations_dict, norm_dict)
        if translation is not None:
            result.append({
                "text": line["text"],
                "translation": translation,
                "bbox": line["bbox"],
                "origin": line["origin"],
                "size": line["size"],
                "line_count": 1,
            })
            i += 1
            continue

        # --- try combining with next lines ---
        best_translation = None
        best_key = None
        best_count = 1  # how many lines consumed
        best_combined = line["text"]
        best_bbox = line["bbox"]

        combined_text = line["text"]
        combined_bbox = line["bbox"]
        first_origin = line["origin"]
        font_size = line["size"]

        for j in range(1, min(MAX_JOIN, len(lines) - i)):
            nxt = lines[i + j]
            # Join with a space
            combined_text = combined_text.strip() + " " + nxt["text"].strip()
            # Expand bounding box
            combined_bbox = (
                min(combined_bbox[0], nxt["bbox"][0]),
                min(combined_bbox[1], nxt["bbox"][1]),
                max(combined_bbox[2], nxt["bbox"][2]),
                max(combined_bbox[3], nxt["bbox"][3]),
            )

            translation, key = match_dict(combined_text, translations_dict, norm_dict)
            if translation is not None:
                best_translation = translation
                best_key = key
                best_count = j + 1
                best_combined = combined_text.strip()
                best_bbox = combined_bbox

        if best_translation is not None:
            result.append({
                "text": best_combined,
                "translation": best_translation,
                "bbox": best_bbox,
                "origin": first_origin,
                "size": font_size,
                "line_count": best_count,
            })
            i += best_count
            continue

        # --- no match found – keep original line untranslated ---
        result.append({
            "text": line["text"],
            "translation": None,
            "bbox": line["bbox"],
            "origin": line["origin"],
            "size": line["size"],
            "line_count": 1,
        })
        i += 1

    return result


def recreate_pdf(input_path, output_path, translations_dict):
    """Recreate a PDF with translated text, removing original French text."""
    src_doc = fitz.open(input_path)
    dst_doc = fitz.open()

    for page_num in range(len(src_doc)):
        src_page = src_doc[page_num]
        text_lines = extract_text_lines(src_page)
        paragraphs = reassemble_paragraphs(text_lines, translations_dict)

        # Create a new page with same size
        rect = src_page.rect
        dst_page = dst_doc.new_page(width=rect.width, height=rect.height)

        # Copy the full page (graphics, images, forms) from source
        dst_page.show_pdf_page(rect, src_doc, page_num)

        # Redact all text areas with white fill to remove original text
        for para in paragraphs:
            bbox = fitz.Rect(para["bbox"])
            bbox = bbox + (-1, -1, 1, 1)
            dst_page.add_redact_annot(bbox, fill=(1, 1, 1))

        # Apply redactions
        dst_page.apply_redactions(images=fitz.PDF_REDACT_IMAGE_NONE)

        # Add translated text
        for para in paragraphs:
            translated = para["translation"] if para["translation"] is not None else para["text"]

            # For single-line or short text, use insert_text
            if para["line_count"] <= 2 or len(translated) < 120:
                dst_page.insert_text(
                    fitz.Point(para["origin"][0], para["origin"][1]),
                    translated,
                    fontname="helv",
                    fontsize=para["size"],
                    color=(0.13, 0.15, 0.35),
                )
            else:
                # For long paragraphs, use insert_textbox with word-wrap
                bbox_rect = fitz.Rect(para["bbox"])
                # Expand width to right margin, keep original left/height
                bbox_rect.x1 = rect.width - 30
                bbox_rect.y1 = bbox_rect.y0 + (para["line_count"] * para["size"] * 1.5) + 20

                rc = dst_page.insert_textbox(
                    bbox_rect,
                    translated,
                    fontname="helv",
                    fontsize=para["size"],
                    color=(0.13, 0.15, 0.35),
                    align=0,  # left align
                )
                # If textbox overflows, fall back to insert_text (truncated)
                if rc < 0:
                    dst_page.insert_text(
                        fitz.Point(para["origin"][0], para["origin"][1]),
                        translated,
                        fontname="helv",
                        fontsize=para["size"],
                        color=(0.13, 0.15, 0.35),
                    )

    # Save with garbage collection and compression
    dst_doc.save(output_path, garbage=4, deflate=True, clean=True)
    src_doc.close()
    dst_doc.close()


def main():
    template = sys.argv[1] if len(sys.argv) > 1 else "bail-1-an"
    lang = sys.argv[2] if len(sys.argv) > 2 else "en"
    
    if template not in TRANSLATIONS:
        print(f"Unknown template: {template}")
        print(f"Available templates: {list(TRANSLATIONS.keys())}")
        sys.exit(1)
    
    if lang not in TRANSLATIONS[template]:
        print(f"Unknown language: {lang}")
        print(f"Available languages: {list(TRANSLATIONS[template].keys())}")
        sys.exit(1)
    
    # Paths
    base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if template == "bail-1-an":
        input_pdf = os.path.join(base_dir, "public", "templates", "SQUARE_METER_template_Bail_Habitation_1_An.pdf")
        output_dir = os.path.join(base_dir, "public", "templates", "langues", "bail-habitation-1-an")
    else:
        input_pdf = os.path.join(base_dir, "public", "templates", "SQUARE_METER_template_Bail_Habitation_3_Ans.pdf")
        output_dir = os.path.join(base_dir, "public", "templates", "langues", "bail-habitation-3-ans")
    
    os.makedirs(output_dir, exist_ok=True)
    if template == "bail-1-an":
        output_pdf = os.path.join(output_dir, f"Bail_Habitation_1_An_{lang.upper()}.pdf")
    else:
        output_pdf = os.path.join(output_dir, f"Bail_Habitation_3_Ans_{lang.upper()}.pdf")
    
    print(f"Translating {template} to {lang}...")
    print(f"Input: {input_pdf}")
    print(f"Output: {output_pdf}")
    
    recreate_pdf(input_pdf, output_pdf, TRANSLATIONS[template][lang])
    
    # Check file size
    input_size = os.path.getsize(input_pdf) / 1024
    output_size = os.path.getsize(output_pdf) / 1024
    print(f"Input size: {input_size:.1f} KB")
    print(f"Output size: {output_size:.1f} KB")
    print(f"Size change: {((output_size - input_size) / input_size * 100):+.1f}%")


if __name__ == "__main__":
    main()
